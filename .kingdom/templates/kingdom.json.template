{
  "_comment": "Kingdom config for this project. Read by the King at /kingdom:start. Workers/co-workers are GENERIC capacity — no preset focus or path locks. King assigns each task at dispatch time. Domain-agnostic: works for code, research, finance, science, manuscripts, anything you version with git.",

  "shape": {
    "workers": 3,
    "co-workers": 1,
    "watchman": 1,
    "seniors": 1,
    "sanityCap": 10
  },

  "git": {
    "base": "develop",
    "integrationBranch": "kingdom",
    "pushPolicy": "always-ask",
    "branchNamingPattern": "feature/<topic>"
  },

  "integration": {
    "_comment": "Story-pod model (v0.32.0+). When enabled and a unit needs >1 worker, the King opens a local story integration branch owned by a Senior; pod workers merge into it; the Senior reviews it as a whole; only the final story->develop PR reaches origin. Single-worker quick tasks still use the solo worker->feature path. Set enabled=false to keep the classic per-worker flow.",
    "enabled": true,
    "unit": "story",
    "branchPattern": "story/<id>",
    "gateOnStory": true,
    "reviewLoopCap": 3
  },

  "workers": [
    { "slug": "worker-1", "model": "opus" },
    { "slug": "worker-2", "model": "opus" },
    { "slug": "worker-3", "model": "opus" }
  ],

  "coworkers": [
    { "slug": "co-worker-1", "model": "opus" }
  ],

  "watchmen": [
    { "slug": "watchman-1", "model": "sonnet", "cadence": "dynamic", "docsAudit": true }
  ],

  "seniors": [
    { "_comment": "Senior-N (v0.32.0+): Opus per-story sub-orchestrator + sole within-story reviewer. Owns a worker pod, merges their branches into the story branch, runs the review loop, hands a push-eligible story to the King. Counts against sanityCap.", "slug": "senior-1", "model": "opus" }
  ],

  "gate": {
    "_comment": "King runs these inside the lane's worktree before approving a push. Keys are arbitrary — rename, add, or remove to fit your domain. Defaults below assume a dev stack; for finance use 'validate' / 'audit', for science 'reproduce' / 'peer-review', for writing 'spellcheck' / 'fact-check'. Each value is a list of bash commands.",
    "typecheck": [],
    "tests": [],
    "smoke": [],
    "lint": []
  },

  "cmux": {
    "_comment": "How kingdom lays out roles in manaflow/cmux.app. Three-tier hierarchy: Workspace per master (King + workers + co-workers + watchman), Tab inside a master's workspace for visible sub-agent spawns (auto-close on sentinel flag), Split for predefined dual-view (watchman). Set 'enabled': false to use raw tmux fallback instead.",
    "enabled": true,
    "pinKingWorkspace": true,
    "spawnWindow": "current",
    "_spawnWindowComment": "Multi-window cmux support (v0.27.0+). 'current' (default): lanes spawn in caller's process window (King's window) — same as pre-0.27.0 behaviour. 'new': open a fresh cmux window and pin all lanes there (King moves to it). 'window:N' or '<uuid>': pin to a specific window by ref/UUID. Multi-window confirmed working in 8-window setups; refs are globally unique so cross-window dispatch works without extra flags.",
    "workspaceColors": {
      "_comment": "cmux named-color set (case-insensitive): Red Crimson Orange Amber Olive Green Teal Aqua Blue Navy Indigo Purple Magenta Rose Brown Charcoal. Or use #RRGGBB hex. NOTE: 'violet' is NOT a cmux color — use 'Purple' (or 'Indigo' as alternative).",
      "king":     "Amber",
      "worker":   "Purple",
      "coworker": "Blue",
      "watchman": "Rose",
      "senior":   "Teal"
    },
    "subAgentSpawnByModel": {
      "_comment": "Model-tiered default spawn mode. v0.28.0+: ALL models default to 'tab' per R38 (visible sub-agent work). Background (in-process Agent()) is opt-in per-model — set explicitly when you want a hidden fan-out (rare). Tab spawns are slower (~10-20s boot) but observable, cancellable, audit-trail-clean. The compressed 'local agent' indicator in cmux is banned for kingdom work.",
      "haiku":  "tab",
      "sonnet": "tab",
      "opus":   "tab"
    },
    "subAgentSpawnFallback": "tab",
    "_subAgentSpawnFallbackComment": "Used when model is unknown / not in subAgentSpawnByModel. Defaults to 'tab' (safer — visibility on unexpected work).",
    "subAgentPool": {
      "_comment": "Pre-warmed sub-agent process pool (v0.18.0+). Each master keeps N idle `claude -p` processes ready in hidden tabs; sub-agent spawn becomes `cmux send` to existing surface (~20ms) instead of new-terminal-right + full Claude boot (~10-20s). Refilled in background after each consumption. Disable by setting enabled=false. Only applies to tab-mode spawns; Agent() background spawns are already cheap.",
      "enabled": true,
      "perMasterPoolSize": 2,
      "models": ["sonnet"]
    },
    "watchmanLayout": {
      "_comment": "Dual-view watchman: top pane is the watchman Claude session (/loop), bottom pane is a live gh PR monitor. Set to null to disable the split and use a single-pane watchman workspace.",
      "direction": "vertical",
      "split": 0.6,
      "topCommand": "claude",
      "bottomCommand": "gh pr list --watch --interval 30"
    }
  },

  "watchman": {
    "_comment": "Autonomous watchman config (v0.29.0+, per rules.md R39 + R40). The watchman runs its /loop fully autonomously; King never dispatches to it. Per tick, watchman can spawn up to haikuCapPerTick Haiku sub-agents in parallel for: code review (diff per touched file), CVE scan (npm/pnpm/pip/cargo audit), cross-lane conflict scan, git hygiene scan.",
    "haikuCapPerTick": 5,
    "haikuCapMax": 10,
    "duties": {
      "_comment": "Each duty can be disabled per-project. Defaults all-on. Disable selectively for projects where the duty isn't valuable.",
      "codeReview": true,
      "cveScan": true,
      "conflictScan": true,
      "gitHygiene": true,
      "crossStoryScan": true
    }
  }
}

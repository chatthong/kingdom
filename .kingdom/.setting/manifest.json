{
  "_comment": "Feature registry. Function NAMES are action-based, not role-based — any role loads any helper. Grouped by BACKEND/CAPABILITY: core (always) deps cmux; cmux (always; the cmux.app PRIMARY backend); tmux (v0.41.0; the FALLBACK backend — load_feature tmux when cmux is absent, then KINGDOM_BACKEND=tmux routes cmux_* calls to tmux); browser (on-demand). Backend gating, not role gating.",
  "features": {
    "core": {
      "always": true,
      "deps": [
        "cmux",
        "tmux"
      ],
      "functions": [
        "_bounded_wait",
        "attach_or_create_worktree",
        "carve_and_push_feature",
        "compute_gate_duration",
        "compute_ready_for_fresh_work",
        "compute_task_duration",
        "create_story_branch",
        "cross_story_scan",
        "curated_path",
        "extract_pr_title_from_task_file",
        "fetch_weather_line",
        "find_ungated_sentinels",
        "generate_pr_body_from_task_file",
        "get_pr_title_from_task_file",
        "guard_commit_branch",
        "guard_dispatch_scope",
        "guard_lane_workspace_exists",
        "guard_no_worktree_cd",
        "haiku_read_docs_orientation",
        "inbox_list",
        "inbox_pending_count",
        "inbox_read",
        "inbox_reply",
        "inbox_send",
        "init_subagent_pool",
        "kingdom_backend_init",
        "kingdom_detect_backend",
        "kingdom_discard_overlay",
        "kingdom_overlay_lane",
        "kingdom_repair_stale_lanes",
        "kingdom_reset",
        "kingdom_resync_after_merge",
        "kingdom_review_surface",
        "latest_test_report",
        "make_artifact_id",
        "merge_into_story",
        "parallel_edit_fanout",
        "pattern_grep_fanout",
        "pick_next_task_for",
        "pick_skills_for_task",
        "poll_for_sentinels",
        "random_task_done_line",
        "raw_path",
        "read_session_state",
        "render_card",
        "review_tick",
        "rules_digest",
        "run_tier1_gate",
        "run_tier2_gate",
        "run_tier2_on_story",
        "save_session_state",
        "spawn_loop",
        "spawn_master_workspace",
        "spawn_pool_slot",
        "spawn_subagent_from_pool",
        "spawn_subagent_tab",
        "summarise_gate_failure",
        "wait_for_ter_decision"
      ]
    },
    "cmux": {
      "always": true,
      "_comment": "One micro-wrapper per cmux subcommand.",
      "functions": [
        "cmux_attention_clear",
        "cmux_attention_override",
        "cmux_capture_pane",
        "cmux_close_surface",
        "cmux_close_window",
        "cmux_close_workspace",
        "cmux_first_surface",
        "cmux_identify",
        "cmux_list_pane_surfaces",
        "cmux_list_panes",
        "cmux_list_workspaces",
        "cmux_new_split",
        "cmux_new_window",
        "cmux_new_workspace",
        "cmux_notify",
        "cmux_read_screen",
        "cmux_rpc",
        "cmux_send",
        "cmux_send_key",
        "cmux_set_state",
        "cmux_tab_action",
        "cmux_tree",
        "cmux_workspace_action"
      ]
    },
    "tmux": {
      "_comment": "FALLBACK backend (v0.41.0): one micro-wrapper per tmux op (mirrors cmux/). One tmux session whose windows are the lanes; the status-bar window list = the cmux colored-workspace sidebar. `load_feature tmux` then set KINGDOM_BACKEND=tmux (the activator kingdom_use_tmux_backend — listed last — routes all cmux_*/spawn_* calls to tmux). Used when cmux.app is unavailable (Linux, or macOS without cmux).",
      "functions": [
        "tmux_capture_pane",
        "tmux_close_workspace",
        "tmux_identify",
        "tmux_list_workspaces",
        "tmux_new_split",
        "tmux_new_workspace",
        "tmux_notify",
        "tmux_read_screen",
        "tmux_send",
        "tmux_send_key",
        "tmux_set_state",
        "tmux_setup_session",
        "tmux_tab_action",
        "tmux_target",
        "tmux_tree",
        "tmux_workspace_action",
        "kingdom_use_tmux_backend"
      ]
    },
    "browser": {
      "deps": [
        "cmux"
      ],
      "_comment": "On-demand built-in-browser verification: load_feature browser.",
      "functions": [
        "browser_click",
        "browser_close",
        "browser_eval",
        "browser_fill",
        "browser_open",
        "browser_screenshot",
        "browser_snapshot",
        "browser_verify"
      ]
    }
  }
}
